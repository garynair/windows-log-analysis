    {
      "id": 9,
      "type": "logs",
      "title": "Daily AI digest (n8n or script)",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 7,
        "w": 24,
        "x": 0,
        "y": 12
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "{job=\"ai_digest\"} | json | line_format \"[{{.severity | ToUpper}}] {{.headline}}  (source: {{.source}}, floor: {{.severity_floor}})\"",
          "queryType": "range"
        }
      ],
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true
      }
