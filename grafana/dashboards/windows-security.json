    {
      "id": 14,
      "type": "table",
      "title": "Top DNS names",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 37
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "topk(15, sum by (qname) (count_over_time({job=\"windows\", channel=\"Microsoft-Windows-DNS-Client/Operational\"} | regexp `for the name (?P<qname>[^, ]+)` | qname!=\"localhost\" [$__range])))",
          "queryType": "instant",
          "legendFormat": "{{qname}}"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "qname": "Domain",
              "Value #A": "Queries",
              "Value": "Queries"
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "Queries",
                "desc": true
              }
            ]
          }
        }
      ],
      "options": {
        "showHeader": true
      }
    },
    {
      "id": 15,
      "type": "table",
      "title": "AI services seen in DNS (shadow AI)",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 37
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "topk(15, sum by (qname) (count_over_time({job=\"windows\", channel=\"Microsoft-Windows-DNS-Client/Operational\"} | regexp `for the name (?P<qname>[^, ]+)` | qname=~`(?i).*(openai|chatgpt|anthropic|claude|gemini|perplexity|copilot|huggingface|deepseek|mistral|poe\\.com).*` | qname!=\"localhost\" [$__range])))",
          "queryType": "instant",
          "legendFormat": "{{qname}}"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "qname": "Domain",
              "Value #A": "Queries",
              "Value": "Queries"
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "Queries",
                "desc": true
              }
            ]
          }
        }
      ],
      "options": {
